@{
    ViewData["Title"] = "Home Page";
}

@section Metadata
{
    <meta name="description" content="Create a group on Gruppering - Join a course using a code and get assigned a group."/>
}

<header>
    
</header>

<div class="home-page text-center">
    <svg id="banner-svg" 
        xmlns="http://www.w3.org/2000/svg" viewBox="0 0 750 200" width="900">
        <defs>
            <path id="logoCurve"
                  d="M 100 380 C 100 150, 230 60, 375 60 C 520 60, 650 150, 650 380"/>
        </defs>

        <text font-size="79" font-weight="bold" text-anchor="middle">
            <textPath xlink:href="#logoCurve" startOffset="51%">
                GRUPPERING!
            </textPath>
        </text>
    </svg>
    <section class="join-section">
        <div>
            <h2>Join a course here!</h2>
            <partial name="_CourseCodeSearch"/>
        </div>
    </section>
    <!--<div class="screen-divider"></div>-->
    <section class="groups-section">
        <h2>My Groups:</h2>
        <div class="groups-list">
            <partial name="_GroupCard"/>
        </div>
    </section>
</div>

<div class="text-center">
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
