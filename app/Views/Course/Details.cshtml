@using System.Security.Claims
@model app.ViewModel.CourseDetailViewModel
@{
    ViewData["Title"] = "Course - " + Model.Course.DisplayName;  
}
<!-- ATM just consceptual structure of detailed view -->
<h1>@Model.Course.DisplayName</h1>
<h2>Join Code: @Model.Course.JoinCode</h2>
<p>@Model.Course.Description</p>
<a asp-controller="Course" asp-action="Join"
   asp-route-joinCode="@Model.Course.JoinCode">Join course</a>
<div style="max-width: 20%">
    @Model.QrCode
</div>
<a asp-controller=""
   asp-action="Grupper"
   asp-route-gruppeId=""
>Grupper</a>

<div id="groups">
    @foreach (var group in Model.GroupsInCourse)
    {
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">@group.GroupName</h5>
                <ul>
                    @foreach (var member in group.Members)
                    {
                        <li>
                            <span>
                                @member.Username
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

@if (Model.IsOwner && !Model.GroupsInCourse.Any())
{
    <div>
        <form>
            <label for="groupAmount">Amount of Groups</label>
            <input type="number" id="groupAmount"/>
            <label for="groupPrefix">Group Prefix</label>

            <input type="text" id="groupPrefix" value="Group"/>
            
            <button type="submit">Generate Random Groups</button>
        </form>
    </div>
     
}


@foreach(var user in Model.UsersInCourse)
{
    <p>@user.username</p>
    
}
<h3>Chat Messages</h3>
<section id="chatMessages">
    @foreach (var chatMessage in Model.ChatMessages)
    {
        <div id="message:@chatMessage.Id" data-message-id="@chatMessage.Id" data-message-user="@chatMessage.UserId">
            <span></span>
            <span>@chatMessage.Username: @chatMessage.Message</span>
            
            @if (chatMessage.UserId.ToString() == Context.User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value)
            {
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Message Actions
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Edit Message</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" onclick="deleteMessage('@chatMessage.Id')">Delete</a></li>
                    </ul>
                </div>
            }
        </div>
    }
</section>
<script>
    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;

    
    // Taken from here: https://park.is/blog_posts/20240803_extracting_timestamp_from_uuid_v7/
    function extractTimestampFromUUIDv7(uuid) {
        // split the UUID into its components
        const parts = uuid.split("-");

        // the second part of the UUID contains the high bits of the timestamp (48 bits in total)
        const highBitsHex = parts[0] + parts[1].slice(0, 4);

        // convert the high bits from hex to decimal
        const timestampInMilliseconds = parseInt(highBitsHex, 16);

        // convert the timestamp to a Date object
        return new Date(timestampInMilliseconds).toLocaleString(navigator.languages[0],{timezone:timezone});
    }


    const chatMessageNodes = document.getElementById("chatMessages");
    // This script exists to easily get the timezone and preferred locale of the user, instead of having to send it over to the server and process it there.
    for (let i = 0; i < chatMessageNodes.children.length; i++){
        let nodeId = chatMessageNodes.children[i].id;
        let uuid = nodeId.replace("message:","");
        // The last part of this method chain (toLocaleString) gives us the local time, instead of utc time.
        chatMessageNodes.children[i].children[0].textContent = extractTimestampFromUUIDv7(uuid);
    }
</script>

<label for="textMessage"></label>
<input type="text" id="textMessage" name="textMessage"/>
<button onclick="sendMessage()">Send Message</button>

@if (Model.IsOwner && !Model.GroupsInCourse.Any())
{
        <script>
        const groupDiv = document.getElementById("groups");

        const groupAmount = document.getElementById("groupAmount");
        const groupPrefix = document.getElementById("groupPrefix");
        let groupingData;
        document.addEventListener("submit",async (e) => {
            e.preventDefault();
            
            fetch("/course/@Model.Course.DisplayName/groups/new",{
                method: "POST",
                credentials:"same-origin",
                body: JSON.stringify({
                    "groupAmount":groupAmount.value,
                    "groupPrefix":groupPrefix.value
                },
                ),
                headers: {
                    "Content-Type":"application/json"
                }
            }).then(async (result) => {
                if (result.ok) {
                    const bod = await result.json()
                    populateGroup(bod)
                }
            })
    })
    
    function populateGroup(groups){
        groups.forEach((group)=> {
            console.log(group)
            processElement(group)
        })
    }
    function processElement(element){
            let wrapper = document.createElement("div");
            let groupTitle = document.createElement("h3");
            groupTitle.textContent = element.groupName;
            let groupMembers = document.createElement("ul");
            // groupMembers.setAttribute("hidden","true");
            
            element.members.forEach((member) => {
                let groupMember = document.createElement("li");
                let groupMemberTitle = document.createElement("span");
                
                groupMemberTitle.textContent = member.username;
                
                groupMember.append(groupMemberTitle);
                
                groupMembers.append(groupMember);
            })
            wrapper.append(groupTitle);
            wrapper.append(groupMembers);
        
            groupDiv.append(wrapper)
    }
</script>

}

@section Scripts
{
    <script async>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chat")
            .configureLogging(signalR.LogLevel.Information)
            .build();

        const channel = "course:@Model.Course.JoinCode";


        async function start() {
            try {
                await connection.start();
                console.log("SignalR Connected.");
            } catch (err) {
                console.log(err);
                setTimeout(start, 5000);
            }
        }

        connection.on("ReceiveMessage", (messageDto) => {
            let rootElement = document.getElementById("chatMessages");
            let newChatElement = document.createElement("div");
            
            newChatElement.id = "message:" + messageDto.id;
            newChatElement.setAttribute("data-chat-user",messageDto.userId);
            
            let newChatDateElement = document.createElement("span");
            newChatDateElement.textContent = extractTimestampFromUUIDv7(messageDto.userId).toLocaleString(navigator.languages[0],{timezone:Intl.DateTimeFormat().resolvedOptions().timeZone});
            newChatElement.append(newChatDateElement);
            
            let newChatTextElement = document.createElement("span");
            newChatTextElement.textContent = `${messageDto.username}: ${messageDto.message}`;
            newChatElement.append(newChatTextElement);
            
            
            let dropdown = document.getElementById("dropdown-template").cloneNode(true);
            
            //dropdown.children[1].children[2].setAttribute("onclick",`deleteMessage(${messageDto.id})`)
            
            newChatElement.append(dropdown);
            
            newChatElement.children[newChatElement.children.length -1].classList.remove("visually-hidden");
            newChatElement.children[newChatElement.children.length -1]
                .children[1]
                .children[2]
                .setAttribute("onclick",`deleteMessage("${messageDto.id}")`);
            
            rootElement.append(newChatElement);
            
        });
        
        connection.on("MessageDeleted", (messageId) => {
            console.log("Deleting message: " + messageId);
            
            let elem = document.getElementById("message:" + messageId);
            elem.parentNode.removeChild(elem);
        })

        connection.on("UserConnected", (message) => {
            console.log(message);
        });

        connection.onclose(async () => {
            await start();
        });

        // Start the connection.
        start().then(() => {
            connection.invoke("ConnectToChannel", "course:@Model.Course.JoinCode");
        });
        
        async function sendMessage(){
            try {
                let message = document.getElementById("textMessage").value;
                await connection.invoke("SendMessage", channel, message);
            } catch (err) {
                console.error(err);
            }

        }
        async function deleteMessage(messageId){
            try {
                await connection.invoke("DeleteMessage",channel, messageId);
            } catch (err) {
                console.error(err);
            }

        }
        
    </script>
}

<div class="dropdown visually-hidden" id="dropdown-template">
    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        Message Actions
    </button>
    <ul class="dropdown-menu">
        <li><a class="dropdown-item" href="#">Edit Message</a></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item">Delete</a></li>
    </ul>
</div>
