@{
    var returnUrl = "";
    if (Context.Request.Query.ContainsKey("ReturnUrl"))
    {
        returnUrl = $"?ReturnUrl={Context.Request.Query["ReturnUrl"]}";
    }
}
<div class="text-center">
    @if(ViewBag.Error != null)
    {
        <span>@ViewBag.Error</span>
    }
    <h1 class="display-4">Login</h1>
    <div>
        @if (Environment.GetEnvironmentVariable("GOOGLE_SIGNIN_ENABLED")!.Equals("true"))
        {
            <a href="" id="loginGoogleUrl">Login with Google</a>
        }
    </div>
    <a href="@("/signup" + returnUrl)">Signup instead</a>
    <form action="@("/login" + returnUrl)" method="post">
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" class="form-control" id="username" aria-describedby="username" name="username">
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password">
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>
@if (Environment.GetEnvironmentVariable("GOOGLE_SIGNIN_ENABLED")!.Equals("true"))
{
    <script>
    const handleGoogleAuthentication = () => {
        const params = new URLSearchParams({
            client_id: "@Environment.GetEnvironmentVariable("GOOGLE_CLIENT_ID")",
            redirect_uri: "@Context.Request.Scheme://@Context.Request.Host@Context.Request.PathBase/auth/google",
            response_type: "code",
            scope: "openid email profile",
        });

        const googleUrl = `https://accounts.google.com/o/oauth2/v2/auth?${params}`;

        document.getElementById("loginGoogleUrl").setAttribute("href",googleUrl)
    }
    
    handleGoogleAuthentication();

</script>
}