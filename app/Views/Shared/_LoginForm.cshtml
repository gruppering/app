@{
    var returnUrl = "";
    if (Context.Request.Query.ContainsKey("ReturnUrl"))
    {
        returnUrl = $"?ReturnUrl={Context.Request.Query["ReturnUrl"]}";
    }
}
<div class="login-page">
    @if (ViewBag.Error != null)
    {
        <span>@ViewBag.Error</span>
    }

    <h1 class="display-4">Login</h1>

    <a class="sign-up-button" href="@("/signup" + returnUrl)">
        Or Sign Up
    </a>

    <form action="@("/login" + returnUrl)" method="post" class="login-form">

        <div class="login-methods">

            <!-- Traditional login -->
            <div class="traditional-login">
                <h2>Traditional:</h2>

                <div class="login-form-group">
                    <label for="username">Username:</label>
                    <input type="text"
                           id="username"
                           name="username"
                           class="login-input">
                </div>

                <div class="login-form-group">
                    <label for="password">Password:</label>
                    <input type="password"
                           id="password"
                           name="password"
                           class="login-input">
                </div>
            </div>

            <!-- Social login -->
            <div class="login-providers">
                <h2>Or Sign In With:</h2>

                <ul class="login-provider-list">
                    <li>
                        @if (Environment.GetEnvironmentVariable("GOOGLE_SIGNIN_ENABLED")!.Equals("true"))
                        {
                            <a href="" id="loginGoogleUrl" class="login-provider">
                                <img src="~/images/google-icon-logo-svgrepo-com.svg"
                                     title="Login with Google account"
                                     alt="Google icon" />
                                <span>Google</span>
                            </a>
                        }
                    </li>

                    <li>
                        @if (Environment.GetEnvironmentVariable("GITHUB_SIGNIN_ENABLED")!.Equals("true"))
                        {
                            <a href="" id="loginGithubUrl" class="login-provider">
                                <img src="~/images/github-icon-1-logo-svgrepo-com.svg"
                                     title="Login with GitHub account"
                                     alt="GitHub icon" />
                                <span>GitHub</span>
                            </a>
                        }
                    </li>
                </ul>
            </div>

        </div>

        <button type="submit" class="login-submit-button">
            Sign In
        </button>

    </form>
</div>
@if (Environment.GetEnvironmentVariable("GOOGLE_SIGNIN_ENABLED")!.Equals("true"))
{
    <script>
    const handleGoogleAuthentication = () => {
        const params = new URLSearchParams({
            client_id: "@Environment.GetEnvironmentVariable("GOOGLE_CLIENT_ID")",
            redirect_uri: "@Context.Request.Scheme://@Context.Request.Host@Context.Request.PathBase/auth/google",
            response_type: "code",
            scope: "openid email profile",
        });

        const googleUrl = `https://accounts.google.com/o/oauth2/v2/auth?${params}`;

        document.getElementById("loginGoogleUrl").setAttribute("href",googleUrl)
    }
    
    handleGoogleAuthentication();

</script>
}

@if (Environment.GetEnvironmentVariable("GITHUB_SIGNIN_ENABLED")!.Equals("true"))
{
    <script>
    const handleGithubAuthenticationUrl = () => {
        const params = new URLSearchParams({
            client_id: "@Environment.GetEnvironmentVariable("GITHUB_CLIENT_ID")",
            redirect_uri: "@Context.Request.Scheme://@Context.Request.Host@Context.Request.PathBase/auth/github",
            scope: "read:user user:email",
        });

        const githubUrl = `https://github.com/login/oauth/authorize?${params}`;

        document.getElementById("loginGithubUrl").setAttribute("href",githubUrl)
    }
    
    handleGithubAuthenticationUrl();

</script>
}