@model IEnumerable<Group>
<!-- For now this loop does go through all the groups the user is in NOTE: add a breaking point if we want -->
@foreach (var group in Model)
{
    <div class="group-card">
        <span class="group-card-status"></span>

        <div class="group-card-info">
            <h3>@group.GroupName</h3>
            <p>Part of: @group.Course</p>
        </div>

        <div class="group-card-actions">
            <a asp-controller="Course"
               asp-action="Details"
               asp-route-id="1"
               class="group-card-button">
                Go to Group
            </a>

            <a asp-controller="Course"
               asp-action="Details"
               asp-route-id="1"
               class="group-card-button">
                Go to Course
            </a>
        </div>
    </div>
}