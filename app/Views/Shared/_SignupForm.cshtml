@{
    var returnUrl = "";
    if (Context.Request.Query.ContainsKey("ReturnUrl"))
    {
        returnUrl = $"?ReturnUrl={Context.Request.Query["ReturnUrl"]}";
    }
}
<div class="login-page">
    @if (ViewBag.Error != null)
    {
        <span>@ViewBag.Error</span>
    }

    <h1 class="display-4">Signup</h1>

    <a class="submit-button signup" href="@("/login" + returnUrl)">
        Or Login
    </a>

    <form action="@("/signup" + returnUrl)" method="post" class="traditional-login-form">

        <div class="login-methods">

            <!-- Traditional signup -->
            <div class="traditional-login">
                <h2>Traditional:</h2>

                <div class="login-form-group">
                    <label for="email">E-Mail:</label>
                    <input type="email"
                           id="email"
                           name="email"
                           class="login-input">
                </div>

                <div class="login-form-group">
                    <label for="username">Username:</label>
                    <input type="text"
                           id="username"
                           name="username"
                           class="login-input">
                </div>

                <div class="login-form-group">
                    <label for="password">Password:</label>
                    <input type="password"
                           id="password"
                           name="password"
                           class="login-input">
                </div>
            </div>

            <!-- Social signup -->
            <div class="login-providers">
                <h2>Or Sign Up With:</h2>

                <ul class="login-provider-list">
                    <li>
                        @if (Environment.GetEnvironmentVariable("GOOGLE_SIGNIN_ENABLED")!.Equals("true"))
                        {
                            <a href="" id="loginGoogleUrl" class="login-provider">
                                <img src="~/images/google-icon-logo-svgrepo-com.svg"
                                     title="Sign up with Google account"
                                     alt="Google icon" />
                                <span>Google</span>
                            </a>
                        }
                    </li>
                    <li>
                        @if (Environment.GetEnvironmentVariable("GITHUB_SIGNIN_ENABLED")!.Equals("true"))
                        {
                            <a href="" id="loginGithubUrl" class="login-provider">
                                <img src="~/images/github-icon-1-logo-svgrepo-com.svg"
                                     title="Login with GitHub account"
                                     alt="GitHub icon" />
                                <span>GitHub</span>
                            </a>
                        }
                    </li>
                </ul>
            </div>

        </div>

        <button type="submit" class="submit-button">
            Sign Up
        </button>

    </form>
</div>