<div class="card">
    <div class="card-body">
        <h5 class="card-title">Create a course</h5>

        <form asp-controller="Course"
              asp-action="CreateCourse"
              method="post">

            <div class="mb-3">
                <label for="CourseName" class="form-label">
                    Course name
                </label>

                <input id="CourseName" name="CourseName"
                       class="form-control"
                       placeholder="Enter course name" />

                <span asp-validation-for="CreateCourse.CourseName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="Description" class="form-label">
                    Description
                </label>

                <textarea id="Description" name="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Describe your course"></textarea>

                <span asp-validation-for="CreateCourse.Description"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input name="IsPublic"
                       id="IsPublic"
                       type="checkbox"
                       class="form-check-input" value="true" />
                <input name="IsPublic" type="hidden" value="false"/>
                
                <label for="IsPublic" 
                       class="form-check-label">
                    Public course
                </label>
            </div>

            <button type="submit" class="btn btn-primary">
                Create course
            </button>
        </form>
    </div>
</div>